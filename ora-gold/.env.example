# =============================================================================
# Ora Gold — متغيرات البيئة (Vite)
# =============================================================================
#
# 1) انسخ هذا الملف إلى `.env.local` (لا ترفع `.env.local` على GitHub):
#      cp .env.example .env.local
#
# 2) عدّل القيم في `.env.local` ثم أعد تشغيل السيرفر:
#      npm run dev
#
# 3) على Vercel: Project → Settings → Environment Variables
#    أضف نفس الأسماء (VITE_*) لبيئة Production و Preview.
#
# ملاحظة: يمكنك أيضاً إدخال المفتاح من التطبيق (مساعد Ora Gold → إعدادات ⚙️)
#         بدون ملف .env — يُحفظ المفتاح في localStorage على جهازك فقط.
#
# =============================================================================

# --- مساعد الذكاء الاصطناعي (اختياري) ---
# بدون مفتاح: يعمل المساعد في وضع «محلي» (أسئلة شائعة جاهزة).
# مع مفتاح: يتصل بـ API متوافق مع OpenAI Chat Completions.

# عنوان الخادم (بدون / في النهاية — الكود يضيف /chat/completions)
# OpenAI (الافتراضي):
VITE_AI_API_BASE=https://api.openai.com/v1

# أمثلة مزودين آخرين (غيّر BASE + MODEL + المفتاح):
# OpenRouter:
# VITE_AI_API_BASE=https://openrouter.ai/api/v1
# VITE_AI_MODEL=openai/gpt-4o-mini
# Groq:
# VITE_AI_API_BASE=https://api.groq.com/openai/v1
# VITE_AI_MODEL=llama-3.3-70b-versatile
# LM Studio / Ollama محلي (OpenAI-compatible):
# VITE_AI_API_BASE=http://localhost:1234/v1
# VITE_AI_MODEL=local-model

# مفتاح API — لا تضع قيمة حقيقية هنا؛ ضعها في .env.local أو Vercel فقط
# مثال شكل المفتاح (OpenAI): sk-proj-xxxxxxxx
VITE_AI_API_KEY=

# اسم الموديل كما يتوقعه المزود
VITE_AI_MODEL=gpt-4o-mini

# بدائل شائعة لـ OpenAI:
# VITE_AI_MODEL=gpt-4o
# VITE_AI_MODEL=gpt-4.1-mini
